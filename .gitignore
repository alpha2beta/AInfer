# AInfer: large artifacts stay local (pinned model + converted container).
# Docs that describe them (manifest.json, memory_budget.json,
# conversion_report.json, config.json) ARE committed.
*.binfer
*.safetensors
*.gguf
*.ot

# CMake build trees (reproducible via CMakePresets.json)
build-*/
cmake-build-*/

# Compiler bundle droppings at repo root (re-generated by build)
kernels-*
--max-new=4

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
*~

# Local binaries & toolchain sysroot (paths are explicit so tool source dirs stay tracked)
tools/l0probe/l0probe
tools/l0load/l0load
tools/toolchain/cache/
tools/toolchain/sysroot/

# CMake build trees inside tool dirs
tools/l0probe/build/

# HF download cache
.cache/

